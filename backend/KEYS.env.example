# Modelo do backend/KEYS.env — copie para KEYS.env (ou rode `npm run setup`
# na raiz) e preencha. O KEYS.env de verdade NUNCA vai para o Git: ele está
# no .gitignore porque guarda senhas. Este modelo só tem os nomes.

# --- Banco de dados ------------------------------------------------------
# MongoDB Atlas > Database > Connect > Drivers (copie a connection string).
# Num computador novo, libere o IP dele em Security > Network Access.
# Sem ele (ou sem acesso ao Atlas nesta rede), rode  npm run dev:local : o
# servidor usa um MongoDB LOCAL (backend/.localdb) já com dados de demonstração.
# Os dados criados nele ficam só neste computador. Em produção é obrigatório.
MONGODB_URI=

# local = sempre usar o banco local (o mesmo que npm run dev:local)
DB_MODE=

# --- Recomendado ---------------------------------------------------------
# Segredo que assina os logins (qualquer texto longo e aleatório).
# Sem ele, em desenvolvimento o servidor gera um temporário a cada reinício;
# em produção (NODE_ENV=production) ele é obrigatório.
JWT_SECRET=

# Google AI Studio (aistudio.google.com) — assistente, briefing, moodboard.
# Sem ela, essas partes usam respostas padrão em vez da IA.
GEMINI_API_KEY=

# --- Opcional ------------------------------------------------------------
# Unsplash (unsplash.com/developers) — imagens de referência dos arquitetos.
UNSPLASH_ACCESS_KEY=

# E-mail (boas-vindas, senha, contratação, mensagens). Sem nada disto, o
# e-mail só aparece no console. Escolha UM jeito de enviar:
#  - Brevo (brevo.com, grátis 300/dia): funciona no Render grátis, que
#    bloqueia SMTP. Cole a chave de API (SMTP & API > API Keys).
BREVO_API_KEY=
#  - ou SMTP (ex.: Gmail com "senha de app"): só local ou em plano pago.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
# Remetente (nos dois casos). Na Brevo, precisa ser um remetente verificado.
# Ex.: match.IA <seuemail@gmail.com>
EMAIL_FROM=
# Endereço público do site, usado nos links dos e-mails. No Render já vem
# sozinho (RENDER_EXTERNAL_URL); preencha só se usar domínio próprio.
APP_URL=

# Porta do servidor (padrão 3000).
PORT=3000
